# =========================================================
#  PACKET LOSS - Modèle de configuration d'environnement
#  Copier ce fichier en .env puis renseigner les valeurs.
#  Le fichier .env ne doit JAMAIS être versionné.
# =========================================================

# ----- Application -----
# APP_DEBUG doit rester false en production (sinon fuite de messages d'erreur).
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/PACKET_LOSS
APP_NAME="Packet Loss Intelligence"

# ----- Base applicative centrale (users, roles, sessions, ...) -----
DB_CORE_HOST=10.171.16.120
DB_CORE_PORT=3306
DB_CORE_NAME=npm_core
DB_CORE_USER=root
DB_CORE_PASS=change-me

# ----- Sources de données métier par pays (lecture seule) -----
# CI - Côte d'Ivoire
DB_CI_HOST=10.171.16.120
DB_CI_PORT=3306
DB_CI_NAME=prismis
DB_CI_USER=root
DB_CI_PASS=change-me

# BJ - Bénin
DB_BJ_HOST=10.22.33.116
DB_BJ_PORT=3306
DB_BJ_NAME=prismis
DB_BJ_USER=fonpm
DB_BJ_PASS=change-me

# TG - Togo (packet loss à venir)
DB_TG_HOST=10.86.228.24
DB_TG_PORT=3306
DB_TG_NAME=prismis
DB_TG_USER=root
DB_TG_PASS=change-me

# ----- Sessions -----
SESSION_NAME=pl_session
SESSION_LIFETIME=28800

# ----- Email / SMS (log en dev, réel en prod) -----
MAIL_DRIVER=log
MAIL_FROM=alerts@packetloss.local
SMS_DRIVER=log
