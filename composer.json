{
    "name": "packet-loss/intelligence",
    "description": "Packet Loss Intelligence - supervision et analyse reseau multi-pays",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Npm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Npm\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
